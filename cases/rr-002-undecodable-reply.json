{
  "id": "RR-002",
  "title": "a reply the caller cannot decode is raised as a decode error, not waited out",
  "requirements": ["AMQP-RR-002", "AMQP-RR-003"],
  "comment": "Python, Go and Ruby parked the reply and the caller timed out; Go and Ruby also left .dlq and .parked queues behind for every reply queue.",
  "steps": [
    {"broker": "declareQueue", "queue": "${ns}.requests"},
    {"broker": "respond", "queue": "${ns}.requests", "body": "this is not JSON", "contentType": "application/json"},
    {"driver": "request", "exchange": "", "routingKey": "${ns}.requests", "body": {"sku": "A-1"}, "timeoutMs": 15000, "as": "call"},
    {"expect": "step", "step": "call", "match": {"ok": false, "error": {"kind": "decode"}, "elapsedMs": {"$lt": 5000}}},
    {"expect": "noNewQueues", "pattern": "\\.(dlq|parked)$"},
    {"driver": "end"},
    {"expect": "noNewQueues", "pattern": "\\.(dlq|parked)$"}
  ]
}
