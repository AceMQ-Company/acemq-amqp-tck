{
  "id": "PUB-001",
  "title": "a retry hop the broker refuses requeues only that delivery, and the consumer carries on, with the user's publisher confirms off",
  "requirements": [
    "AMQP-PUB-001",
    "AMQP-PUB-002"
  ],
  "comment": "The same case as RETRY-001, with confirms off for the user's own publishes: an on-behalf publish is confirmed and mandatory regardless. A library without a confirms switch always confirms and passes trivially.",
  "steps": [
    {
      "driver": "consume",
      "queue": "${ns}.work",
      "handle": "c1",
      "prefetch": 2,
      "retry": {
        "maxAttempts": 3,
        "delayMs": 5000
      },
      "behaviour": {
        "failFirst": {
          "m1": 1
        },
        "sleepMs": 100
      }
    },
    {
      "expect": "consumers",
      "queue": "${ns}.work",
      "count": 1,
      "withinMs": 10000
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m1"
      }
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m2"
      }
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m3"
      }
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m4"
      }
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m5"
      }
    },
    {
      "broker": "policy",
      "name": "${ns}.refuse",
      "pattern": "^${nsre}\\.work(\\.retry\\..+)?$",
      "definition": {
        "max-length": 0,
        "overflow": "reject-publish"
      }
    },
    {
      "comment": "the hop is attempted at about 5s and refused",
      "sleep": 6000
    },
    {
      "expect": "driver",
      "call": {
        "op": "handled",
        "handle": "c1"
      },
      "withinMs": 20000,
      "match": {
        "counts": {
          "m1": 2,
          "m2": 1,
          "m3": 1,
          "m4": 1,
          "m5": 1
        },
        "redelivered": {
          "m1": 1,
          "m2": {
            "$absent": true
          },
          "m3": {
            "$absent": true
          },
          "m4": {
            "$absent": true
          },
          "m5": {
            "$absent": true
          }
        }
      }
    },
    {
      "expect": "consumers",
      "queue": "${ns}.work",
      "count": 1
    },
    {
      "broker": "clearPolicy",
      "name": "${ns}.refuse"
    },
    {
      "sleep": 1000
    },
    {
      "driver": "publish",
      "exchange": "",
      "routingKey": "${ns}.work",
      "body": {
        "id": "m6"
      }
    },
    {
      "expect": "driver",
      "call": {
        "op": "handled",
        "handle": "c1"
      },
      "withinMs": 15000,
      "match": {
        "counts": {
          "m1": 2,
          "m2": 1,
          "m3": 1,
          "m4": 1,
          "m5": 1,
          "m6": 1
        }
      }
    },
    {
      "expect": "depth",
      "queue": "${ns}.work",
      "count": 0,
      "withinMs": 10000
    },
    {
      "expect": "noMessagesIn",
      "pattern": "^${nsre}\\.work\\.(dlq|parked)$"
    }
  ],
  "begin": {
    "confirms": false
  }
}
